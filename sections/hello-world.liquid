{% for block in section.blocks %}

    <h3>{{ block.type }}</h3>

{% endfor %}

{% schema %}
{
    "name" : "Hello World",
    "settings" : [
    ],
    "blocks" : [
        {
            "type" : "title",
            "name" : "Title",
            "settings" : [
                {
                    "type" : "color",
                    "id" : "bg_color",
                    "label" : "Background Color",
                    "default" : "#e9e9e9"
                },
                {
                    "type" : "color",
                    "id" : "text_color",
                    "label" : "Text Color",
                    "default" : "#000000"
                }
            ]
        },
        {
            "name" : "Subtitle",
            "type" : "subtitle",
            "settings" : [
                {
                    "type" : "color",
                    "id" : "bg_color",
                    "label" : "Background Color",
                    "default" : "#eeeeee"
                },
                {
                    "type" : "color",
                    "id" : "text_color",
                    "label" : "Text Color",
                    "default" : "#ff0000"
                }
            ]
        }
    ],
    "presets" : [
        {
            "name" : "Hello World"
        }
    ]
}
 
