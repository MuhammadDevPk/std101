{% style %}
    {% for block in section.blocks %}
        {% case block.type %}
        {% when 'title' %}
        .bg-color-title {
            background-color: {{ block.settings.bg_color }}
        }
        .text-color-title {
            color: {{ block.settings.text_color }}
        }
        {% when 'subtitle' %}
        .bg-color-subtitle {
            background-color: {{ block.settings.bg_color }}
        }
        .text-color-subtitle {
            color: {{ block.settings.text_color }}
        }
        {% endcase %}

    {% endfor %}
{% endstyle %}

<div style="text-align: {{ section.settings.text_alignment }}">
{%- for block in section.blocks -%}

    {%- case block.type -%}
        {%- when 'title' -%}
            <h2 class="bg-color-title text-color-title"> Title </h2>
        {%- when 'subtitle' -%}
            <h5 class="bg-color-subtitle text-color-subtitle"> Subtitle </h5>
    {%- endcase -%}

{%- endfor -%}
</div>
{% schema %}
{
    "name" : "Hello World",
    "settings" : [
        {
            "type" : "select",
            "id" : "text_alignment",
            "label" : "Text Alignment",
            "default" : "center",
            "info" : "align the text in section",
            "options" : [
                {
                    "value" : "left",
                    "label" : "Left"
                },
                {
                    "value" : "center",
                    "label" : "Center"
                },
                {
                    "value" : "right",
                    "label" : "Right"
                }
            ]
        }
    ],
    "blocks" : [
        {
            "type" : "title",
            "name" : "Title",
            "settings" : [
                {
                    "type" : "color",
                    "id" : "bg_color",
                    "label" : "Background Color",
                    "default" : "#e9e9e9"
                },
                {
                    "type" : "color",
                    "id" : "text_color",
                    "label" : "Text Color",
                    "default" : "#000000"
                }
            ]
        },
        {
            "name" : "Subtitle",
            "type" : "subtitle",
            "settings" : [
                {
                    "type" : "color",
                    "id" : "bg_color",
                    "label" : "Background Color",
                    "default" : "#FFC0CB"
                },
                {
                    "type" : "color",
                    "id" : "text_color",
                    "label" : "Text Color",
                    "default" : "#ff0000"
                }
            ]
        }
    ],
    "presets" : [
        {
            "name" : "Hello World"
        }
    ]
}
 
{% endschema %}