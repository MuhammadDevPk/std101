{% style %}
    .hello-world {
        background-color: {{ section.settings.bg_color }}
    }
{% endstyle %}

<h1 class="hello-world"> {{ section.settings.title }}</h1>


{% schema %}
{
    "name" : "Hello World",
    "settings" : [
        {
            "type" : "text",
            "id" : "title",
            "label" : "Title",
            "default" : "Hello World"
        },
        {
            "type" : "color",
            "id" : "bg_color",
            "label" : "Background Color",
            "default" : "#e9e9e9"
        }
    ],
    "presets" : [
        {
            "name" : "Hello World"
        }
    ]
}
 
{% endschema %}